+          <input type="radio" name="classificacao_status" value="automatico"{% if classificacao_status == 'automatico' %} checked{% endif %} />
+          <span>Classificar automaticamente</span>
+        </label>
+        <label class="toggle-option">
+          <input type="radio" name="classificacao_status" value="manter"{% if classificacao_status != 'automatico' %} checked{% endif %} />
+          <span>Manter como Quero jogar</span>
+        </label>
+      </fieldset>
+
+      <div class="checkbox-field" style="margin-bottom: var(--space-4);">
+        <label for="steam-reclassificar{% if modo_modal %}-modal{% endif %}">
+          <input type="checkbox" id="steam-reclassificar{% if modo_modal %}-modal{% endif %}" name="reclassificar_existentes" value="1"{% if reclassificar_existentes %} checked{% endif %} />
+          Reclassificar também jogos Steam existentes que ainda estão como Quero jogar
+        </label>
+      </div>
+
+      <button type="submit" class="btn btn-primary btn-block" data-submit-label>Analisar biblioteca</button>
+      <div class="import-progress" data-import-progress role="status" aria-live="polite">
+        <strong>Analisando biblioteca Steam…</strong>
+        <p class="hint">A prévia consulta biblioteca, atividade recente e progresso de conquistas, mas ainda não altera o banco.</p>
+      </div>
+    </form>
+
+    {% if not modo_modal %}<p class="auth-switch"><a href="{{ url_for('pages.backlog') }}">Voltar ao backlog</a></p>{% endif %}
+  </section>
+  {% endif %}
+</div>
