+<div class="steam-import-layout steam-import-layout--single{% if previsao %} steam-import-layout--preview{% elif resultado %} steam-import-layout--result{% else %} steam-import-layout--form{% endif %}" data-steam-import-root data-steam-synced="{{ '1' if resultado else '0' }}">
