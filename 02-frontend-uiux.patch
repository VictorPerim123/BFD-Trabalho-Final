+      {% endif %}
+    </div>
+    {% if modo_modal %}
+    <div class="steam-stage-actions">
+      <button type="button" class="btn btn-ghost" data-steam-restart>Sincronizar novamente</button>
+      <button type="button" class="btn btn-primary" data-steam-close>Concluir</button>
+    </div>
+    {% else %}
+    <div class="steam-stage-actions">
